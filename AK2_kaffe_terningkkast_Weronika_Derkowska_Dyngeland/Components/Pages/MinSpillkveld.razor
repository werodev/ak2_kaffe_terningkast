@page "/game-night"
@using BlazorApp1.State
@inject GameNightState GameNight

<p>Found @GameNight.Count games</p>
<p>Takes in total: @GameNight.TotalPlayTime minutes to play it</p>
<h3 class="text-center text-body-emphasis">Min Spillkveld</h3>
@if (!GameNight.SelectedGames.Any())
{
<p>Didn't found it</p>
}
else
{
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
    @foreach (var game in GameNight.SelectedGames)
    { 
        <div class="col">
            <GameCard Game="game" IsInGameNight="true" OnRemove="GameNight.RemoveGame"/>
        </div>
    }
</div>            
}    

