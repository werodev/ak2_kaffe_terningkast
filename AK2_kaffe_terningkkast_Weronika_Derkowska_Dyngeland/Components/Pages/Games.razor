@page "/games"
@inject GameApiClient Api

<div class="d-flex flex-wrap gap-3 fw-bold opacity-75">
    <div class="d-flex flex-wrap gap-3 fw-bold opacity-75 border-1">
        <p>Find a game:</p>
        <input type="text" @bind="gameSearch" @bind:event="oninput"/>
    </div>
    <div class="d-flex flex-wrap gap-3 fw-bold opacity-75 border-1">
        <p>Number of Players:</p>
        <input type="text" @bind="playersNumber" @bind:event="oninput"/>
    </div>
    <div class="d-flex flex-wrap gap-3 fw-bold opacity-75 border-1">
        <p>Try your luck:</p>
        <button @onclick="Terningkast">Terningkast</button>
    </div>
</div>
<p>Found @FoundGames.Count() games</p>
@if (addMessage != null)
{
    <p>@addMessage</p>
}

@if (games is null)
{
    <p>Loading boardgames...</p>
}
else
{
    <h3 class="text-center text-body-emphasis">Spillhylla</h3>
    if (!FoundGames.Any())
    {
        <p>Didn't found it</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
            @foreach (var game in FoundGames)
            { 
                <div class="col">
                    <GameCard Game="game" IsSelected="@(selectedGame != null && game.Id == selectedGame.Id)" OnAdd="HandleAdd"/>
                </div>
            }
        </div>            
    }
    
}

@code {
    List<BoardGame>? games;
    protected override async Task OnInitializedAsync()
    {
        games = await Api.GetBoardGamesAsync();
    }
    private string? gameSearch;
    private int? playersNumber;
    private BoardGame? selectedGame;
    private string? addMessage;
    
    private IEnumerable<BoardGame> FoundGames => 
        games?.Where(game =>                                // is checking games where
            (string.IsNullOrWhiteSpace(gameSearch) ||        // input is not null or whitespace -> if it is we show all the games on the list 
            game.Name.Contains(                             // and if game name contains typed in value
                gameSearch,  
                StringComparison.OrdinalIgnoreCase))        // ignore the case - input might be with small or big characters and we want search to ignore it 
        &&                                                  // need to meet also conditions for players number
        (playersNumber == null || 
        playersNumber == 0 ||
        (playersNumber >= game.MinPlayers && playersNumber <= game.MaxPlayers)))
        
        ??
        Enumerable.Empty<BoardGame>();                      // if empty we show empty list

    private void Terningkast()
    {
        var results = FoundGames.ToList();
        if (results.Count == 0)
        {
            return;
        }
        int diceRoll = Random.Shared.Next(0, results.Count);
        selectedGame= results[diceRoll];
    }

    private void HandleAdd(int gameId)
    {
        var pickedGame = games?.FirstOrDefault(game => game.Id == gameId);
        addMessage = $"{pickedGame?.Name} was added";
    }

}