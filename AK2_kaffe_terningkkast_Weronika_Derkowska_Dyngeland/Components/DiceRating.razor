@* Child is playing a dice roll and giving parent information about result *@

@for (int i = 1; i <= 6; i++)
{
    int rating = i;
    <button class="@(Value==rating ? "btn-secondary" : "btn-primary") "@onclick="() => ValueChangedClicked(rating)" disabled="@ReadOnly">@rating</button>  @* when method gets argument in blazor we need to use lambda *@
}

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    
    private async Task ValueChangedClicked(int rating)
        => await ValueChanged.InvokeAsync(rating);

}