@using BlazorApp1.State
@inject GameNightState GameNight
@implements IDisposable
 
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Kaffe Terningkast</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/home" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/games">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Spillhylla
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/game-night">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Min Spillkveld (@GameNight.Count)
            </NavLink>
        </div>
    </nav>
</div>

@* Event listener - subscription *@
@code {
    protected override void OnInitialized() // is done when component is created
    {
        GameNight.OnChange += HandleStateChange;
    }
    private async void HandleStateChange()  // refresh menu when the game list is changing
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        GameNight.OnChange -= HandleStateChange; // when Blazor removes NavMenu it's triggering Dispose and removing subscription for HandleStateChange / removing event listener
    }
} 