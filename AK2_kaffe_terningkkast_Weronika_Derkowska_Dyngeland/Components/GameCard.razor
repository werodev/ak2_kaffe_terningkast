<div class="@(IsSelected ? "selected-card" : "game-card") position-relative">
    <NavLink href="@($"/games/{Game.Id}")" class="stretched-link">
        <span class="visually-hidden">Display: @Game.Name</span>
    </NavLink>
    <div class="card-header ">
        <h4>@Game.Name</h4>
        <p>Category: @Game.Category</p>
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-3 fw-bold opacity-75">
            <p>@Game.MinPlayers - @Game.MaxPlayers players </p>
            <p>Age: @Game.MinAge+</p>
            <p>Takes around @Game.PlayTimeMinutes minutes</p>
            <p>Rating: <DiceRating Value="@Game.Rating" ReadOnly="true"/></p>
        </div>
        <p>Description: @Game.Description</p>
    </div>
    <div class="d-flex justify-content-end m-3 position-relative z-2">
        <button class="btn btn-outline-secondary" @onclick="OnAddClicked">Add to Min spillekveld</button>
    </div>
</div>



@code {
    [Parameter] public BoardGame Game { get; set; } = new();
    [Parameter] public bool IsSelected { get; set; }  // it's false by default
    [Parameter] public EventCallback<int> OnAdd { get; set; }
    
    private async Task OnAddClicked()
        => await OnAdd.InvokeAsync(Game.Id);
}